---
/*
 * Home — the nocturne archive's opening leaf.
 *
 * Hero is a THESIS, not a metric: an opening line set large in Fraunces,
 * lamplit, stating what this place does — reads books on your behalf and keeps
 * the commentary. The living volume count is a quiet catalog stamp beneath it,
 * NOT the headline. Then a running list of recently annotated volumes with
 * foxed-ink marginalia, and the shelves typeset into gilt rules.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import Marginalia from '~/components/Marginalia.astro'
import { getCollection } from 'astro:content'
import { SITE_CONFIG } from '~/lib/siteConfig'

const allBooks = await getCollection('books')
const totalBooks = allBooks.length

const overview = await getCollection('overview')
const content = await getCollection('content')
const analysis = await getCollection('analysis')
const narration = await getCollection('narration')

const slugHas = (col: { id: string }[], slug: string) =>
  col.some((e) => e.id.replace(/\\/g, '/').toLowerCase().includes(`/${slug.toLowerCase()}/`))

interface Annotated {
  slug: string
  title: string
  authors: string[]
  category?: string
  addedAt: number
  sections: { overview: boolean; content: boolean; analysis: boolean; narration: boolean }
  filled: number
}

const annotated: Annotated[] = allBooks.map((b) => {
  const sections = {
    overview: slugHas(overview, b.data.slug),
    content: slugHas(content, b.data.slug),
    analysis: slugHas(analysis, b.data.slug),
    narration: slugHas(narration, b.data.slug),
  }
  const filled = Object.values(sections).filter(Boolean).length
  return {
    slug: b.data.slug,
    title: b.data.title,
    authors: b.data.authors,
    category: b.data.category,
    addedAt: b.data.addedAt ?? 0,
    sections,
    filled,
  }
})

const recent = [...annotated]
  .sort((a, b) => b.addedAt - a.addedAt || a.title.localeCompare(b.title))
  .slice(0, 8)

const handNotes: Record<string, string> = {
  'thinking-fast-and-slow-daniel-kahneman': 'this one finally clicked on reread',
  'noise-daniel-kahneman': 'narration pending; analysis is enough',
}

function labelFromSlug(slug: string) {
  const cleaned = slug.replace(/^\d+-/, '')
  return cleaned
    .split('-')
    .map((w) => (['ai', 'ui', 'ux', 'api', 'seo'].includes(w) ? w.toUpperCase() : w))
    .join(' ')
}
const shelfMap = new Map<string, { label: string; count: number }>()
for (const b of allBooks) {
  const cat = b.data.category ?? 'uncategorized'
  if (!shelfMap.has(cat)) shelfMap.set(cat, { label: labelFromSlug(cat), count: 0 })
  shelfMap.get(cat)!.count += 1
}
const shelves = Array.from(shelfMap.values()).sort((a, b) => b.count - a.count)

const issueNo = String(totalBooks).padStart(3, '0')

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'oriz·lore',
    url: SITE_CONFIG.origin,
    description: SITE_CONFIG.description,
    inLanguage: 'en',
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'oriz·lore — the nocturne archive',
    url: SITE_CONFIG.origin,
    description: SITE_CONFIG.description,
    isAccessibleForFree: true,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: totalBooks,
      name: 'Annotated volumes',
    },
  },
]
---

<BaseLayout
  title={`oriz·lore — ${SITE_CONFIG.tagline}`}
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
>
  <section class="spine masthead" aria-labelledby="thesis">
    <p class="stamp mono-caps">
      <span class="stamp-word">the nocturne archive</span>
      <span class="stamp-no">No.&nbsp;{issueNo}</span>
    </p>
    <h1 class="thesis" id="thesis">
      Every book here has been <em>read to the end</em>,
      so the next reader can begin <em>in the middle</em>.
    </h1>
    <p class="lede">
      Structured commentary kept by lamplight — <span class="four mono-caps">overview
      · content&nbsp;map · analysis · narration</span> — for
      <span class="count">{totalBooks}</span> volumes and counting. Nothing here is gated.
      Open any leaf.
    </p>
    <p class="enter">
      <a href="/books/" class="enter-link">enter the shelves ›</a>
    </p>
  </section>

  <hr class="hairline" />

  <section class="spine annotated" aria-labelledby="annotated-h">
    <h2 id="annotated-h" class="section-h label-display">most recently annotated</h2>
    <ol class="run-list">
      {recent.map((b) => (
        <li class="run-row" data-slug={b.slug}>
          <a href={`/books/${b.slug}/`} class="run-link">
            <div class="run-head">
              <span class="run-title">{b.title}</span>
              <span class="run-byline">{b.authors[0] ? `· ${b.authors[0]}` : ''}</span>
              <span class="run-suff" aria-label={`${b.filled} of 4 sections written`}>
                {Array.from({ length: 4 }).map((_, i) => (
                  <span class={i < b.filled ? 'pip fill' : 'pip'} aria-hidden="true"></span>
                ))}
              </span>
            </div>
            <p class="run-sections mono-caps" aria-hidden="true">
              <span class={b.sections.overview ? '' : 'absent'}>overview</span>
              <span class="mid">·</span>
              <span class={b.sections.content ? '' : 'absent'}>content map</span>
              <span class="mid">·</span>
              <span class={b.sections.analysis ? '' : 'absent'}>analysis</span>
              <span class="mid">·</span>
              <span class={b.sections.narration ? '' : 'absent'}>narration</span>
            </p>
          </a>
          {handNotes[b.slug] && (
            <div class="run-margin">
              <Marginalia note={handNotes[b.slug]} />
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="spine shelves" aria-labelledby="shelves-h">
    <h2 id="shelves-h" class="section-h label-display">the shelves</h2>
    <ul class="shelf-list">
      {shelves.map((s) => (
        <li class="shelf">
          <a href={`/categories/#${s.label.replace(/\s+/g, '-')}`} class="shelf-link">
            <span class="shelf-name">{s.label}</span>
            <span class="shelf-count mono-caps">{s.count} {s.count === 1 ? 'vol' : 'vols'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .masthead {
    padding-block: clamp(3rem, 9vw, 5.5rem) 2.25rem;
    position: relative;
  }
  .stamp {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: var(--brass);
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .stamp-word {
    letter-spacing: 0.24em;
    color: var(--brass);
  }
  .stamp-no {
    color: var(--dust);
    font-variant-numeric: tabular-nums;
  }
  .thesis {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: clamp(2.1rem, 5.6vw, 3.55rem);
    line-height: 1.08;
    letter-spacing: -0.018em;
    margin: 0;
    max-width: 18ch;
    color: var(--ink);
    text-wrap: balance;
  }
  .thesis em {
    font-style: italic;
    font-weight: 500;
    color: var(--brass);
  }
  .lede {
    margin: 1.75rem 0 0;
    color: var(--ink-mute);
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.65;
    max-width: 52ch;
  }
  .lede .four {
    color: var(--dust);
    font-size: 0.72em;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .lede .count {
    color: var(--brass);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.92em;
  }
  .enter {
    margin: 1.75rem 0 0;
  }
  .enter-link {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--verdigris, #6e9e86);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--bottle) 45%, transparent);
    padding-bottom: 2px;
    transition: color 120ms, border-color 120ms;
  }
  .enter-link:hover {
    color: var(--ink);
    border-color: var(--bottle);
  }

  .annotated {
    padding-block: 2.75rem 1rem;
  }
  .section-h {
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    margin: 0 0 1.5rem;
  }

  .run-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .run-row {
    position: relative;
    padding-block: 1.2rem;
    border-top: 1px solid var(--rule);
  }
  .run-row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .run-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .run-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .run-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: 1.375rem;
    color: var(--ink);
    line-height: 1.2;
    transition: color 120ms;
  }
  .run-link:hover .run-title {
    color: var(--brass);
  }
  .run-byline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-mute);
  }
  .run-suff {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
  }
  .pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--rule);
  }
  .pip.fill {
    background: var(--brass);
    border-color: var(--brass);
    box-shadow: 0 0 6px color-mix(in oklab, var(--brass) 50%, transparent);
  }
  .run-sections {
    margin: 0.55rem 0 0;
    color: var(--dust);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .run-sections .absent {
    color: var(--rule);
    text-decoration: line-through;
    text-decoration-color: var(--rule);
  }
  .run-sections .mid {
    color: var(--brass);
  }
  .run-margin {
    margin-top: 0.25rem;
  }
  @media (min-width: 1100px) {
    .run-row {
      padding-right: 240px;
    }
    .run-margin {
      position: absolute;
      top: 1.3rem;
      right: 0;
      width: 220px;
      margin-top: 0;
    }
    .run-margin :global(.margin-note) {
      transform: rotate(-1.5deg);
      transform-origin: top left;
      border-left: 0;
      padding: 0;
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.4;
      max-width: 22ch;
    }
  }

  .shelves {
    padding-block: 2.25rem 4rem;
  }
  .shelf-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .shelf {
    margin: 0;
  }
  /* Shelf name + count typeset INTO a gilt rule. */
  .shelf-link {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.15rem;
    text-decoration: none;
    color: var(--ink);
  }
  .shelf-link::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: color-mix(in oklab, var(--brass) 40%, transparent);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .shelf-name,
  .shelf-count {
    position: relative;
    background: var(--paper);
    padding-inline: 0.7rem;
    z-index: 1;
  }
  .shelf-name {
    font-family: var(--font-display);
    font-style: italic;
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: 1.2rem;
    color: var(--ink);
    letter-spacing: 0;
    padding-left: 0;
    transition: color 120ms;
  }
  .shelf-count {
    color: var(--brass);
    font-size: 11px;
    padding-right: 0;
  }
  .shelf-link:hover .shelf-name {
    color: var(--brass);
  }
</style>
