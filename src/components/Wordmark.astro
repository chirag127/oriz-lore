---
/*
 * Wordmark — oriz·lore set in Fraunces italic. The middot glows gilt (--brass),
 * the one lamplit mark on the page. This is the site brand for the nocturne
 * archive; the family "oriz.in" link lives beside it in chrome.
 */
interface Props {
  size?: number
  href?: string | null
}

const { size = 22, href = '/' } = Astro.props
---

{
  href ? (
    <a class="wordmark-link" href={href} aria-label="oriz·lore">
      <span class="wordmark" style={`--wm-size: ${size}px;`}>
        <span class="wordmark-word">oriz</span>
        <span class="wordmark-mid" aria-hidden="true">·</span>
        <span class="wordmark-word">lore</span>
      </span>
    </a>
  ) : (
    <span class="wordmark" style={`--wm-size: ${size}px;`}>
      <span class="wordmark-word">oriz</span>
      <span class="wordmark-mid" aria-hidden="true">·</span>
      <span class="wordmark-word">lore</span>
    </span>
  )
}

<style>
  .wordmark-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-optical-sizing: auto;
    font-size: var(--wm-size, 22px);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .wordmark-word {
    display: inline;
  }
  .wordmark-mid {
    display: inline-block;
    margin-inline: 0.04em;
    color: var(--brass);
    font-style: normal;
    transform: translateY(-0.06em);
    text-shadow: 0 0 10px color-mix(in oklab, var(--brass) 55%, transparent);
  }
</style>
