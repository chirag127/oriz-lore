---
/*
 * AppSidebarContent — per-app sidebar slot content for book·lore.
 *
 * The drawer chrome (sticky aside, burger, off-canvas behavior) comes from
 * @chirag127/astro-chrome/Sidebar.astro. This file owns the *contents*:
 * Browse-by groupings that are specific to a book-summaries site.
 */
const sections = [
  {
    label: 'The archive',
    items: [
      { href: '/books/', label: 'All shelves' },
      { href: '/categories/', label: 'Shelf index' },
    ],
  },
  {
    label: 'Reader',
    items: [
      { href: '/account/', label: 'My shelf' },
      { href: '/about/', label: 'Colophon' },
      { href: 'https://oriz.in', label: 'oriz.in' },
    ],
  },
]
---
{sections.map((g) => (
  <section class="sb-section">
    <h3 class="sb-h">{g.label}</h3>
    <ul class="sb-list">
      {g.items.map((i) => (
        <li><a href={i.href} class="sb-link">{i.label}</a></li>
      ))}
    </ul>
  </section>
))}

<style>
  .sb-section { margin-bottom: 1rem; }
  .sb-h {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dust, #8b93a0);
    margin: 0 0 0.5rem;
  }
  .sb-list { list-style: none; margin: 0; padding: 0; }
  .sb-list li { margin: 0; }
  .sb-link {
    display: block;
    padding: 4px 0;
    color: var(--ink, #e8e0ce);
    text-decoration: none;
    font-size: 14px;
    transition: color 120ms;
  }
  .sb-link:hover { color: var(--brass, #c8a24b); }
</style>
